<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Hybrid SSR + CSR</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <div class="container-md py-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h1 class="h5 mb-0">
              Tabla híbrida: primeras 5 (SSR) + siguientes 5 (CSR)
            </h1>
            <span class="text-muted small"
              >Origen:
              <code
                ><%= (typeof window === 'undefined') ? 'SSR' : 'CSR' %></code
              ></span
            >
          </div>
          <% if (columns.length && values.length) { %>
          <table class="table table-striped table-sm" id="tbl">
            <thead>
              <tr>
                <% columns.forEach(c => { %>
                <th><%= c %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody id="tbody">
              <% values.forEach(row => { %>
              <tr>
                <% columns.forEach((_, i) => { %>
                <td>
                  <%= (row[i] && typeof row[i] === 'object') ?
                  JSON.stringify(row[i]) : (row[i] ?? '') %>
                </td>
                <% }) %>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" id="btnMore">
              Cargar 5 más
            </button>
            <span class="text-muted" id="status"
              >Mostrando 5 de <%= total %></span
            >
          </div>
          <% } else { %>
          <div class="alert alert-warning">Sin datos.</div>
          <% } %>
        </div>
      </div>
    </div>
    <script>
      window.__initial = { page: 1, pageSize: <%= initialPageSize %>, total: <%= total %> };
    </script>
    <script src="/main.js" defer></script>
  </body>
</html>
